TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
TELEGRAM_WEBHOOK_SECRET=your_long_random_webhook_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_MORNING=gemini-3.1-flash-lite
GEMINI_MODEL_EVENING=gemini-3.1-flash-lite
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
CRON_SECRET=your_optional_cron_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# リフレッシュトークンは `node scripts/genGoogleToken.mjs` で自動取得・書き込みされます。
# または Google OAuth 2.0 Playground (https://developers.google.com/oauthplayground)
# で tasks スコープを認可して手動取得しても可。
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
# @default のままでよい（Google Tasks の既定リスト）。別リストを使う場合のみ変更。
GOOGLE_TASKS_LIST_ID=@default
PORT=3001
